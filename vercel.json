{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "images": {
    "sizes": [320, 480, 512, 573, 640, 682, 768, 1024],
    "localPatterns": [
      {
        "pathname": "^/assets/.*\\.png$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 2678400,
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "dangerouslyAllowSVG": false
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/guides/index.html",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/:path(.*\\.html)/",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.provencewineclub.com.au"
        }
      ],
      "destination": "https://provencewineclub.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "emilieblanc.wine"
        }
      ],
      "destination": "https://provencewineclub.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.emilieblanc.wine"
        }
      ],
      "destination": "https://provencewineclub.com.au/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2678400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
